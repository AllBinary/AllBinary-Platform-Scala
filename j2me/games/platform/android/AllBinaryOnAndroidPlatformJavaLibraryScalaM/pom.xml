    <build>
        
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>compile-scala-sources</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target xmlns:if="ant:if">
                                <fileset id="scala.sources" dir="${project.basedir}/src/main/java" includes="**/*.scala" erroronmissingdir="false"/>
                                <!-- A project without .scala files such as a resource jar has nothing to compile -->
                                <condition property="scala.sources.available">
                                    <resourcecount when="greater" count="0" refid="scala.sources"/>
                                </condition>
                                <mkdir dir="${project.build.outputDirectory}"/>
                                <pathconvert property="scala.source.files" refid="scala.sources" pathsep="${line.separator}"/>
                                <echo file="${project.build.directory}/scala-sources.txt" message="${scala.source.files}"/>
                                <path id="scala.library.path">
                                    <fileset dir="${scala.home}/maven2" includes="org/scala-lang/scala-library/**/*.jar,org/scala-lang/scala3-library_3/**/*.jar"/>
                                </path>
                                <path id="scala.compiler.path">
                                    <fileset dir="${scala.home}/maven2" includes="org/scala-lang/scala3-compiler_3/**/*.jar,org/scala-lang/scala3-interfaces/**/*.jar,org/scala-lang/tasty-core_3/**/*.jar,org/scala-lang/scala-library/**/*.jar,org/scala-lang/scala3-library_3/**/*.jar,org/scala-sbt/**/*.jar,org/ow2/asm/**/*.jar"/>
                                </path>
                                <pathconvert property="scala.classpath">
                                    <path refid="maven.compile.classpath"/>
                                    <path refid="scala.library.path"/>
                                </pathconvert>
                                <java if:set="scala.sources.available" classname="dotty.tools.dotc.Main" classpathref="scala.compiler.path" fork="true" failonerror="true">
                                    <jvmarg value="-Xss16m"/>
                                    <arg value="-nowarn"/>
                                    <arg value="-color:never"/>
                                    <arg value="-encoding"/>
                                    <arg value="UTF-8"/>
                                    <arg value="-d"/>
                                    <arg value="${project.build.outputDirectory}"/>
                                    <arg value="-classpath"/>
                                    <arg value="${scala.classpath}"/>
                                    <arg value="@${project.build.directory}/scala-sources.txt"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>



            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <attach>true</attach>
                    <descriptors>
                        <descriptor>assembly.xml</descriptor>
                    </descriptors>
                </configuration>
            </plugin>

        </plugins>

    </build>

</project>

